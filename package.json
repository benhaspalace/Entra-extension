{
  "name": "entra-admin-helper",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Membership governance context for the Microsoft Entra admin center",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "verify": "npm run build && npm test && npm run lint && npm run typecheck && npm run check:terms",
    "check:terms": "node scripts/check-terms.mjs",
    "agent": "node scripts/harness/run.mjs",
    "agent:labels": "node scripts/harness/setup-labels.mjs",
    "pr:comments": "node scripts/pr/comments.mjs",
    "pr:reply": "node scripts/pr/reply.mjs",
    "pr:address": "node scripts/pr/address.mjs",
    "pr:sync": "node scripts/pr/sync.mjs",
    "gate:image": "node scripts/pr/build-gate-image.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/chrome": "^0.3.7",
    "@types/node": "^22.19.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "happy-dom": "^21.0.4",
    "jsdom": "^27.0.1",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
